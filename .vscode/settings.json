{
  "oxc.enable": true,
  "eslint.enable": true,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "vue",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "js/ts.experimental.useTsgo": true,
  "cSpell.words": [
    "attributify",
    "Axios",
    "bumpp",
    "Iconify",
    "Lucide",
    "Nuxt",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "Rollup",
    "tsdown",
    "tsgo",
    "unplugin",
    "unref",
    "unrs",
    "vite",
    "vitepress",
    "Vitest"
  ]
}
