{
  "oxc.enable": true,
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.format.oxc": "explicit"
  },
  "js/ts.experimental.useTsgo": true,
  "cSpell.words": [
    "attributify",
    "Axios",
    "bumpp",
    "Iconify",
    "Lucide",
    "Nuxt",
    "oxfmt",
    "oxfmtrc",
    "oxlint",
    "Rollup",
    "tsdown",
    "tsgo",
    "unplugin",
    "unref",
    "unrs",
    "vite",
    "vitepress",
    "Vitest"
  ]
}
